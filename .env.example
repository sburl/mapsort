# Copy to .env and fill in.
#
# enrich_ratings.py reads GOOGLE_MAPS_API_KEY from .env directly. The
# other variables are read from the environment only, so export them or
# use `set -a; . ./.env; set +a`.

# Google Places API (New). Restrict the key to the Places API and set a
# low quota cap, so a bug cannot bill you.
GOOGLE_MAPS_API_KEY=

# Comma-separated Google account folder names inside the Takeout export.
GOOGLE_ACCOUNTS=default

# Where the unzipped Takeout export lives. Defaults to ./takeout
# TAKEOUT_DIR=/path/to/takeout-2026-02-27

# Optional. A mailto: link shown in each guide so readers can report a
# bad result. The invitation is omitted from guides when this is unset.
# GUIDE_CONTACT=mailto:you@example.com
